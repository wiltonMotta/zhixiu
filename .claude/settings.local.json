{
  "permissions": {
    "allow": [
      "Bash(docker --version)",
      "Bash(kubectl version *)",
      "Bash(sudo apt-get update -qq)",
      "Bash(sudo apt-get install -y ca-certificates curl gnupg lsb-release)",
      "Bash(sudo install -m 0755 -d /etc/apt/keyrings)",
      "Bash(sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg)",
      "Bash(sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg)",
      "Bash(sudo chmod a+r /etc/apt/keyrings/docker.gpg)",
      "Bash(dpkg --print-architecture)",
      "Bash(lsb_release -cs)",
      "Bash(echo \"deb [arch=$\\(dpkg --print-architecture\\) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $\\(lsb_release -cs\\) stable\")",
      "Bash(sudo tee /etc/apt/sources.list.d/docker.list)",
      "Bash(sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin)",
      "Bash(sudo ln -sf /usr/bin/docker /root/private_data/sun/tools/docker)",
      "Bash(sudo ln -sf /usr/local/bin/kubectl /root/private_data/sun/tools/kubectl)",
      "Bash(/root/private_data/sun/tools/docker --version)",
      "Bash(/root/private_data/sun/tools/kubectl version *)",
      "Bash(sudo systemctl status docker --no-pager)",
      "Bash(sudo dockerd)",
      "Bash(sudo docker info --format '{{.ServerVersion}}')",
      "Bash(sudo docker ps)",
      "Bash(sudo dockerd --iptables=false)",
      "Read(//tmp/**)",
      "Read(//usr/bin/**)",
      "Read(//usr/local/bin/**)",
      "Bash(dpkg -l docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin)",
      "Bash(sudo usermod -aG docker sunjg)",
      "Bash(sudo usermod -aG sudo sunjg)"
    ]
  }
}
