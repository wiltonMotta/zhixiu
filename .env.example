# ===== 致秀小程序环境变量模板 =====

# 数据库 PostgreSQL
DATABASE_URL=postgresql://zhixiu:CHANGE_ME@127.0.0.1:5432/zhixiu

# Redis
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# 本地文件存储
STORAGE_PATH=./data/storage/zhixiu-assets
STORAGE_BASE_URL=https://YOUR_DOMAIN/zx-assets/

# 微信小程序
WX_APPID=your_appid
WX_SECRET=your_secret

# 微信支付
WX_PAY_MCH_ID=your_mch_id
WX_PAY_API_KEY=your_api_key
WX_PAY_CERT_PATH=/path/to/cert.pem
WX_PAY_KEY_PATH=/path/to/key.pem

# JWT
JWT_SECRET=change_this_to_random_string

# 后台管理
ADMIN_API_TOKEN=change_this_to_random_string

# 外部访问
EXTERNAL_BASE_URL=https://your-domain.com
API_BASE_URL=https://your-domain.com/api/v1
ADMIN_BASE_URL=https://your-domain.com/admin
